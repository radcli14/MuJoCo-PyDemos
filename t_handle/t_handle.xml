<mujoco model="t_handle">

  <option gravity="0 0 0" integrator="RK4" timestep="0.001"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.30 0.30 0.30" specular="0.10 0.10 0.10"/>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture name="shield_tex" type="2d"
             file="../images/dc-engineer-logo-transparent.png"/>
    <!-- emission="1" makes the logo self-illuminate, independent of scene lighting -->
    <material name="logo_mat"   texture="shield_tex" texrepeat="1 1" rgba="1 1 1 1"
                                emission="1"/>
    <material name="steel"      rgba="0.78 0.82 0.88 1.00"
                                reflectance="0.92" specular="1.0" shininess="1.00"/>
    <material name="steel_dark" rgba="0.28 0.30 0.34 1.00"
                                reflectance="0.20" shininess="0.15"/>
  </asset>

  <worldbody>

    <!-- DC Engineer shield logo — static backdrop, faces camera at azimuth 135 -->
    <body name="backdrop" pos="-0.21 0.21 -0.15">
      <geom name="logo_panel" type="plane" size="0.42 0.42 0.1"
            euler="90 45 0"
            material="logo_mat" contype="0" conaffinity="0"/>
    </body>

    <body name="t_handle">
      <freejoint name="free"/>

      <geom name="bar"        type="cylinder" fromto="-0.1 0 0  0.1 0 0"    size="0.013" material="steel"      density="7700"/>
      <geom name="bar_cap_l"  type="cylinder" fromto="-0.104 0 0 -0.1 0 0"  size="0.017" material="steel_dark" density="7700"/>
      <geom name="bar_cap_r"  type="cylinder" fromto=" 0.1 0 0  0.104 0 0"  size="0.017" material="steel_dark" density="7700"/>
      <geom name="handle"     type="cylinder" fromto=" 0 0.01 0  0 0.11 0"  size="0.011" material="steel"      density="7700"/>
      <geom name="handle_cap" type="cylinder" fromto=" 0 0.11 0  0 0.114 0" size="0.015" material="steel_dark" density="7700"/>
    </body>

  </worldbody>

</mujoco>
