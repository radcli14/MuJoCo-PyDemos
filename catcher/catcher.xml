<mujoco>
  <option timestep="0.0005"/>
  <!-- tau=0.5ms (matches timestep, max contact stiffness), zeta=1 (critically damped, no bounce) -->
  <default>
    <geom solref="0.0005 1"/>
  </default>
  <worldbody>
    <light pos="0 0 10" dir="0 0 -1" diffuse="1 1 1" specular="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="20 20 .1" rgba=".5 .5 .5 1"/>
    <body name="ball" pos="0 18.288 1.829">
      <joint type="free"/>
      <geom type="sphere" size="0.037" rgba="0.95 0.95 0.95 1" mass="0.145"/>
    </body>
    <!-- Torso cross: neck(0,-1.80,1.00), hip(0,-1.80,0.55), shoulders(±0.20,-1.80,0.77) -->
    <!-- Neck ball joint: k=300 N*m/rad, c=60 N*m*s/rad -->
    <body name="torso" pos="0 -1.80 1.00">
      <joint name="neck" type="ball" stiffness="300" damping="60"/>
      <geom type="capsule" fromto="0 0 0  0 0 -0.45"
            size="0.040" rgba="0.85 0.72 0.60 1" mass="20"/>
      <geom type="capsule" fromto="-0.20 0 -0.23  0.20 0 -0.23"
            size="0.030" rgba="0.85 0.72 0.60 1" mass="3"/>
      <!-- Catcher arm: shoulder(-0.20,-1.80,0.77) to elbow(-0.40,-1.30,0.525) to wrist(-0.12,-1.219,0.610) -->
      <!-- Left shoulder behind and above the glove; left elbow out to the left; ~92 deg angle at elbow -->
      <!-- Shoulder ball joint: k=150 N*m/rad, c=30 N*m*s/rad (tau~0.1 s, I~0.75 kg*m^2) -->
      <body name="upper_arm" pos="-0.20 0 -0.23">
        <joint name="shoulder" type="ball" stiffness="150" damping="30"/>
        <geom type="sphere" size="0.025" rgba="0.20 0.45 0.85 1"
              contype="0" conaffinity="0" mass="0"/>
        <geom type="capsule" fromto="0 0 0  -0.20 0.50 -0.245"
              size="0.038" rgba="0.85 0.72 0.60 1" mass="2.0"/>
        <body name="forearm" pos="-0.20 0.50 -0.245">
          <!-- Elbow ball joint: k=34 N*m/rad, c=6.8 N*m*s/rad (tau~0.1 s, I~0.17 kg*m^2) -->
          <joint name="elbow" type="ball" stiffness="34" damping="6.8"/>
          <geom type="sphere" size="0.025" rgba="0.20 0.45 0.85 1"
                contype="0" conaffinity="0" mass="0"/>
          <geom type="capsule" fromto="0 0 0  0.28 0.081 0.085"
                size="0.030" rgba="0.85 0.72 0.60 1" mass="1.2"/>
          <!-- Mitt: thin leather disc, wrist hinge at left (-X) edge -->
          <body name="glove" pos="0.28 0.081 0.085">
            <!-- Wrist hinge: k=3.6 N*m/rad, c=0.72 N*m*s/rad (tau=0.1 s, I~0.018 kg*m^2) -->
            <joint name="wrist" type="hinge" axis="0 0 1" stiffness="3.6" damping="0.72"/>
            <geom type="sphere" size="0.025" rgba="0.20 0.45 0.85 1"
                  contype="0" conaffinity="0" mass="0"/>
            <geom name="glove" type="cylinder" size="0.12 0.0125"
                  pos="0.12 0 0" euler="-90 0 0"
                  rgba="0.80 0.40 0.10 1" mass="1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
