<mujoco>
  <option timestep="0.0005"/>
  <!-- tau=0.5ms (matches timestep, max contact stiffness), zeta=1 (critically damped, no bounce) -->
  <default>
    <geom solref="0.0005 1"/>
  </default>
  <worldbody>
    <light pos="0 0 10" dir="0 0 -1" diffuse="1 1 1" specular="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="20 20 .1" rgba=".5 .5 .5 1"/>
    <body name="ball" pos="0 18.288 1.829">
      <joint type="free"/>
      <geom type="sphere" size="0.037" rgba="0.95 0.95 0.95 1" mass="0.145"/>
    </body>
    <!-- Catcher arm: shoulder(0.20,-1.80,1.10) to elbow(0.40,-1.30,0.75) to wrist(-0.12,-1.219,0.610) -->
    <!-- Shoulder behind and above the glove; elbow out to the right; ~92 deg angle at elbow -->
    <!-- Shoulder ball joint: k=75 N*m/rad, c=15 N*m*s/rad (tau~0.1 s, I~0.75 kg*m^2) -->
    <body name="upper_arm" pos="0.20 -1.80 1.10">
      <joint name="shoulder" type="ball" stiffness="75" damping="15"/>
      <geom type="sphere" size="0.025" rgba="0.20 0.45 0.85 1"
            contype="0" conaffinity="0" mass="0"/>
      <geom type="capsule" fromto="0 0 0  0.20 0.50 -0.35"
            size="0.038" rgba="0.85 0.72 0.60 1" mass="2.0"/>
      <body name="forearm" pos="0.20 0.50 -0.35">
        <!-- Elbow ball joint: k=17 N*m/rad, c=3.4 N*m*s/rad (tau~0.1 s, I~0.17 kg*m^2) -->
        <joint name="elbow" type="ball" stiffness="17" damping="3.4"/>
        <geom type="sphere" size="0.025" rgba="0.20 0.45 0.85 1"
              contype="0" conaffinity="0" mass="0"/>
        <geom type="capsule" fromto="0 0 0  -0.52 0.081 -0.14"
              size="0.030" rgba="0.85 0.72 0.60 1" mass="1.2"/>
        <!-- Mitt: thin leather disc, wrist hinge at left (-X) edge -->
        <body name="glove" pos="-0.52 0.081 -0.14">
          <!-- Wrist hinge: k=1.8 N*m/rad, c=0.36 N*m*s/rad (tau=0.1 s, I~0.018 kg*m^2) -->
          <joint name="wrist" type="hinge" axis="0 0 1" stiffness="1.8" damping="0.36"/>
          <geom type="sphere" size="0.025" rgba="0.20 0.45 0.85 1"
                contype="0" conaffinity="0" mass="0"/>
          <geom name="glove" type="cylinder" size="0.12 0.0125"
                pos="0.12 0 0" euler="-90 0 0"
                rgba="0.80 0.40 0.10 1" mass="1"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
