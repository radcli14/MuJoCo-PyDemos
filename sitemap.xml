---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
          http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
{% for p in site.pages %}{% if p.layout and p.sitemap != false %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    {% if p.last_modified_at %}<lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
    {% elsif p.date %}<lastmod>{{ p.date | date_to_xmlschema }}</lastmod>{% endif %}
    <priority>{% if p.url == "/" %}1.0{% elsif p.layout == "demo" %}0.9{% else %}0.7{% endif %}</priority>
    <changefreq>monthly</changefreq>
  </url>
{% endif %}{% endfor %}
</urlset>
