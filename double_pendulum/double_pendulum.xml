<mujoco model="double_pendulum">

  <option gravity="0 0 -1.62" integrator="RK4" timestep="0.001"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.30 0.30 0.30" specular="0.10 0.10 0.10"/>
    <global offwidth="1080" offheight="1920"/>
  </visual>

  <asset>
    <!-- DC Engineer shield logo — used as door backdrop texture -->
    <texture name="shield_tex" type="2d"
             file="../images/dc-engineer-logo-transparent.png"/>

    <material name="door_logo_mat" texture="shield_tex" texrepeat="1 1" rgba="1 1 1 1"/>

    <!-- Red plexiglass (link 1) -->
    <material name="link1_mat" rgba="0.88 0.16 0.16 0.72"
              reflectance="0.30" shininess="0.85"/>

    <!-- Blue plexiglass (link 2) -->
    <material name="link2_mat" rgba="0.16 0.36 0.92 0.72"
              reflectance="0.30" shininess="0.85"/>

    <!-- Polished steel hinge pins -->
    <material name="hinge_mat" rgba="0.62 0.66 0.72 1.00"
              reflectance="0.60" shininess="1.00"/>
  </asset>

  <worldbody>

    <!-- ── Static logo backdrop ────────────────────────────────────────── -->
    <body name="backdrop" pos="0 0 0.157">
      <geom name="door_logo" type="plane" size="0.628 0.628 0.1"
            pos="0 0 0" euler="90 180 0"
            material="door_logo_mat" contype="0" conaffinity="0"/>

    </body>

    <!-- ── Pendulum ────────────────────────────────────────────────────── -->
    <body name="pivot_mount">

      <!-- Top pivot pin -->
      <geom name="top_pin" type="cylinder" size="0.009 0.0314"
            pos="0 0.0157 0" euler="90 0 0" material="hinge_mat"
            density="0" contype="0" conaffinity="0"/>

      <!-- ── Link 1 (red plexiglass) ───────────────────────────────── -->
      <body name="link1" pos="0 0.025 0">
        <joint name="j1" type="hinge" axis="0 1 0"/>
        <geom name="bar1" type="box" size="0.022 0.011 0.15"
              pos="0 0 0.125" material="link1_mat"
              density="1180" contype="0" conaffinity="0"/>

        <!-- Mid hinge cylinder -->
        <geom name="mid_pin" type="cylinder" size="0.009 0.0314"
              pos="0 0.0212 0.25" euler="90 0 0" material="hinge_mat"
              density="0" contype="0" conaffinity="0"/>

        <!-- ── Link 2 (blue plexiglass) ──────────────────────────── -->
        <body name="link2" pos="0 0.0305 0.25">
          <joint name="j2" type="hinge" axis="0 1 0"/>

          <geom name="bar2" type="box" size="0.022 0.011 0.15"
                pos="0 0 0.125" material="link2_mat"
                density="1180" contype="0" conaffinity="0"/>

          <!-- End cap sphere at tip of link 2 -->
          <geom name="end_cap" type="sphere" size="0.018"
                pos="0 0 0.25" material="link2_mat"
                density="0" contype="0" conaffinity="0"/>

        </body>
      </body>
    </body>

  </worldbody>

</mujoco>
